#!/bin/sh
# Human accountability: every commit names a ticket and the person who reviewed the change.
#   Subject must start with a ticket key:     INV-143: validate quantity on PUT
#   Message must carry a trailer:             Reviewed-by: Your Name <you@example.com>
# An agent never commits in this project (its permissions deny it), so this is the human's signature on the change.
msg="$1"
subject=$(head -n 1 "$msg")
case "$subject" in Merge\ *|Revert\ *) exit 0 ;; esac
if ! printf '%s' "$subject" | grep -qE '^[A-Z][A-Z0-9_]+-[0-9]+: .+'; then
  echo "commit-msg: the subject must start with a ticket key, like 'INV-143: what changed'." >&2
  exit 1
fi
if ! grep -qE '^Reviewed-by: .+ <.+@.+>' "$msg"; then
  echo "commit-msg: add a trailer 'Reviewed-by: Your Name <you@example.com>' to show a person reviewed this diff." >&2
  echo "           (git commit --trailer 'Reviewed-by: ...' adds it for you.)" >&2
  exit 1
fi
exit 0
